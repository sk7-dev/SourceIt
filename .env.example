# Copy to .env and fill in. apps/api and packages/shared both read these from
# process.env (Zod-validated at boot — see apps/api/src/env.ts,
# packages/shared/src/env.ts). Never commit the real .env.

# Matches docker-compose.yml's postgres service.
DATABASE_URL=postgres://sourceit:sourceit@localhost:5432/sourceit

# From your Clerk project's API Keys page (docs/STACK_PROPOSAL.md: auth = Clerk).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

PORT=3000
NODE_ENV=development

# Required outside development — comma-separated browser origins allowed to
# call the API (e.g. https://app.example.com). In development any origin is
# allowed regardless of this value.
CORS_ORIGIN=
