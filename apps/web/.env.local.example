# Copy to .env.local and fill in. Vite only exposes vars prefixed VITE_ to the
# browser bundle — never put a Clerk *secret* key here, only the publishable
# one (it's meant to be public; see apps/api/README-equivalent env docs for
# where the secret key belongs instead).

VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:3000
