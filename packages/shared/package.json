{
  "name": "@sourceit/shared",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "openapi:generate": "tsx src/openapi/generate.ts",
    "client:generate": "openapi-typescript openapi.json -o src/client/schema.d.ts",
    "seed": "tsx src/seed/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "drizzle-orm": "^0.36.4",
    "openapi-fetch": "^0.13.4",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "openapi-typescript": "^7.5.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
